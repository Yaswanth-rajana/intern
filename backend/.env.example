# Server Configuration
PORT=5000

# MQTT Broker Configuration
MQTT_HOST=127.0.0.1
MQTT_PORT=8883
MQTT_USERNAME=admin
MQTT_PASSWORD=public
MQTT_TOPIC=iaq/device/#,iaq/devices/#,iaq/controller/data

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/iaq_monitoring

# Automated Daily Device Activity Report Configuration
REPORT_TIMEZONE=Asia/Kolkata
DAILY_REPORT_CRON=0 7 * * *
EMAIL_DELIVERY_ENABLED=false

# SMTP Server Credentials (Optional - set EMAIL_DELIVERY_ENABLED=true for live email delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AeroSense
SMTP_SECURE=false

